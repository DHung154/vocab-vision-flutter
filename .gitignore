#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local backend account database (never commit user data)
/backend/data/*.db
/backend/data/*.db-*

# Downloaded content sources and staging dumps stay outside Git.
/raw/
/.avd_runtime/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# This repository publishes the Flutter app, not local plans/server/tooling.
/backend/
/content/
/docs/
/infra/
/tools/
/output/
/.impeccable/
/KE_HOACH_*.md
/CHANGELOG.md
/DESIGN.md
/PRODUCT.md
/assets/**/*.md

# Private/local runtime data and signing material.
.env
.env.*
*.db
*.db-*
*.sqlite
*.sqlite3
*.jks
*.keystore
key.properties
*.apk
*.aab
